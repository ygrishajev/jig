{
  "name": "@ygrishajev/sdlc",
  "version": "0.1.19",
  "description": "Agentic SDLC pipeline orchestrator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sdlc": "./dist/cli/main.js"
  },
  "main": "./dist/cli/main.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrishajev/sdlc.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "secretlint": "secretlint '**/*'",
    "prepare": "husky || true",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "awilix": "^13.0.5",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "latest-version": "^9.0.0",
    "p-retry": "^8.0.1",
    "p-timeout": "^6.1.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "simple-git": "^3.27.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/vitest-runner": "^8.7.0",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "secretlint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0",
    "vitest-mock-extended": "^2.0.2"
  }
}
