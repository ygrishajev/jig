{
  "name": "@ygrishajev/jig",
  "version": "1.0.0",
  "description": "Agentic SDLC pipeline orchestrator",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "bin": {
    "jig": "./dist/cli/main.js"
  },
  "main": "./dist/cli/main.js",
  "files": [
    "dist",
    "presets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrishajev/jig.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "validate": "node --import tsx scripts/validate.ts",
    "build": "tsc -p tsconfig.build.json",
    "install:local": "npm run build && T=$(npm pack --silent | tail -1) && trap 'rm -f \"$T\"' EXIT && env -u _VOLTA_TOOL_RECURSION \"${VOLTA_HOME:+$VOLTA_HOME/bin/}npm\" i -g \"$PWD/$T\"",
    "dev": "tsx src/cli/main.ts",
    "lint": "eslint .",
    "lint:duplication": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:e2e": "npm run build && node --env-file-if-exists=tests/e2e/.env node_modules/vitest/vitest.mjs run --workspace vitest.workspace.ts --project e2e --reporter verbose",
    "test:coverage": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:mutation": "stryker run",
    "secretlint": "secretlint '**/*'",
    "prepare": "husky || true",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@inquirer/prompts": "^8.7.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "awilix": "^13.0.5",
    "better-result": "^3.0.1",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "latest-version": "^9.0.0",
    "p-timeout": "^6.1.4",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "safe-stable-stringify": "^2.5.0",
    "simple-git": "^3.27.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/vitest-runner": "^8.7.0",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "prettier": "^3.4.0",
    "secretlint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0",
    "vitest-mock-extended": "^2.0.2"
  },
  "volta": {
    "node": "26.13.0"
  }
}
