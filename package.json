{
  "name": "@ygrishajev/sdlc",
  "version": "0.1.15",
  "description": "Agentic SDLC pipeline orchestrator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sdlc": "./dist/cli/main.js"
  },
  "main": "./dist/cli/main.js",
  "files": [
    "dist",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrishajev/sdlc.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "secretlint": "secretlint '**/*'",
    "docker:build": "docker build -t sdlc-agent-sandbox docker/agent-sandbox"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/vitest-runner": "^8.7.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "secretlint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0"
  }
}
