# Copy to tests/e2e/.env and fill in the credentials/models you want to exercise.
# Shell environment variables take precedence. Never commit tests/e2e/.env.

# Claude: provide either the subscription token or the API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
JIG_E2E_CLAUDE_MODEL=haiku

# OpenRouter: use the full openrouter/<model> identifier.
OPENROUTER_API_KEY=
JIG_E2E_OPENROUTER_MODEL=
# OPENCODE_MODEL is also accepted when JIG_E2E_OPENROUTER_MODEL is unset.

# Codex: use a full ChatGPT subscription auth.json with its refresh token.
# Optional explicit cache directory; otherwise E2E discovers $CODEX_HOME or ~/.codex.
# JIG_CODEX_AUTH_DIR=/absolute/path/to/dedicated-codex-login
JIG_E2E_CODEX_MODEL=gpt-6-luna
# A private copy of auth.json is mounted writable inside Docker.
# Refreshed credentials are written back to the selected cache on close.
# Serialize runs and avoid sharing a dedicated CI login with other machines.
# Keychain-only login and CODEX_ACCESS_TOKEN are not used by this integration.
